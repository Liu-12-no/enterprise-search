# ==============================
# Enterprise Intelligence Search
# 环境变量配置模板
# ==============================

# --- DeepSeek API (必填) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- JWT 密钥 (必填，请修改为随机字符串) ---
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_chars

# --- MySQL (可选，有默认值) ---
MYSQL_HOST=192.168.200.130
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# --- MinIO (可选，有默认值) ---
MINIO_HOST=192.168.200.130
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

# --- Elasticsearch 业务库 (可选，有默认值) ---
ES_HOST=192.168.200.130
ES_PORT=9200

# --- Elasticsearch 向量库 (可选，有默认值) ---
ES_VECTOR_HOST=192.168.200.130
ES_VECTOR_PORT=9201

# --- Redis (可选，有默认值) ---
REDIS_HOST=192.168.200.130
REDIS_PORT=6379
REDIS_PASSWORD=leadnews

# --- XXL-Job (可选，有默认值) ---
XXL_JOB_ADMIN_HOST=192.168.200.130
XXL_JOB_ADMIN_PORT=8888
