<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.qych.mapper.EntChatSessionMapper">

    <select id="selectDeletedSessionIds" resultType="java.lang.Long">
        SELECT id FROM ent_chat_session WHERE is_deleted = 1
    </select>

    <delete id="physicalDeleteById">
        DELETE FROM ent_chat_session WHERE id = #{id}
    </delete>

</mapper>